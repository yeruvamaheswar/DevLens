{
  "name": "devlens",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test:tracer": "vitest run packages/core/tracer.test.ts",
    "demo": "tsx packages/core/demo.ts",
    "demo:smoke": "tsx packages/core/smoke.ts",
    "ingest:fixture": "tsx packages/core/ingest.ts",
    "check:bundle": "tsx packages/core/bundle-check.ts",
    "scenario:verify": "node examples/broken-api/scripts/scenario-verify.mjs",
    "fixture:verify": "tsx examples/broken-api/scripts/fixture-verify.ts",
    "test:capture": "vitest run packages/capture",
    "probe:claude-hook": "tsx packages/capture/probe.ts",
    "test:sync": "vitest run packages/core/src/sync.test.ts",
    "test:record": "vitest run apps/web/record",
    "test:link": "vitest run packages/link/tests/rules.test.ts",
    "test:rerun": "vitest run packages/link/tests/rerun.test.ts",
    "usage:golden": "tsx packages/core/usage.ts",
    "test:replay": "vitest run apps/web/replay apps/web/questions.test.ts",
    "test:questions": "vitest run packages/questions",
    "build": "next build apps/web",
    "test:agent": "vitest run packages/agent",
    "agent:smoke": "tsx packages/agent/src/smoke.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
