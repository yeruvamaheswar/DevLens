@@ -0,0 +1,13 @@
+// API values use a dash (in-progress); the database stores in_progress.
+const API_TO_STORED = {
+  open: 'open',
+  'in-progress': 'in_progress',
+  completed: 'completed',
+};
+
+export const API_STATUSES = Object.keys(API_TO_STORED);
+
+// Returns the stored value for an API status, or undefined if it is unknown.
+export function normalizeStatus(value) {
+  return Object.hasOwn(API_TO_STORED, value) ? API_TO_STORED[value] : undefined;
+}
