NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: force the local fixture without network access.
DEVLENS_OFFLINE=0
# Server-only gate for the recording routes. Any value other than 1 makes them return 403.
DEVLENS_RECORD_ENABLED=1
# Optional: the folder Claude Code runs in (its CLAUDE_PROJECT_DIR). The question agent route reads and writes .devlens/ there. Unset means the agent is unavailable.
DEVLENS_PROJECT_DIR=
